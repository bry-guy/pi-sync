{
  "name": "@bry-guy/pi-sync",
  "version": "0.1.2",
  "description": "Pi conversation synchronization client, extension, and workspace skill",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./protocol": {
      "types": "./dist/src/protocol.d.ts",
      "import": "./dist/src/protocol.js"
    },
    "./client": {
      "types": "./dist/src/client/client.d.ts",
      "import": "./dist/src/client/client.js"
    },
    "./session": {
      "types": "./dist/src/session/index.d.ts",
      "import": "./dist/src/session/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "conversation",
    "sync"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bry-guy/pi-sync.git",
    "directory": "packages/pi-sync"
  },
  "homepage": "https://github.com/bry-guy/pi-sync#readme",
  "bugs": {
    "url": "https://github.com/bry-guy/pi-sync/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run build",
    "prepack": "npm run build",
    "test:e2e": "npm run build && PI_SYNC_E2E=1 node --test --test-concurrency=1 test/e2e/*.test.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=0.84.4"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "pi": {
    "extensions": [
      "dist/extensions/sync.js"
    ],
    "skills": [
      "skills"
    ]
  }
}
